generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  storageUsed  BigInt   @default(0)
  storageLimit BigInt   @default(5368709120) // 5 GB in bytes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  files         File[]
  folders       Folder[]
  uploadSession UploadSession[]
}

enum FileStatus {
  PENDING
  UPLOADED
  FAILED
}

model Folder {
  id   String @id @default(uuid())
  name String

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Folder[] @relation("FolderHierarchy")

  isStarred Boolean   @default(false)
  isTrashed Boolean   @default(false)
  trashedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]

  @@index([ownerId, parentId])
  @@index([ownerId, createdAt])
}

model File {
  id         String     @id @default(uuid())
  name       String
  mimeType   String
  size       BigInt
  storageKey String?    @unique
  thumbnailKey String?
  checksum   String?
  status     FileStatus @default(PENDING)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  isStarred Boolean   @default(false)
  isTrashed Boolean   @default(false)
  trashedAt DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  uploadSession UploadSession?

  @@index([ownerId, folderId])
  @@index([ownerId, createdAt])
  @@index([ownerId, isStarred])
  @@index([ownerId, isTrashed])
}

enum UploadSessionStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  ABORTED
  FAILED
}

model UploadSession {
  id String @id @default(uuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  fileId String @unique
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  multipartUploadId String @unique
  partSize          Int
  totalParts        Int

  status UploadSessionStatus @default(INITIATED)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([expiresAt])
}
